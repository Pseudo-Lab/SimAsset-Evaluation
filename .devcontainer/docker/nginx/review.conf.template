# 외부 포트 → 컨테이너 안 로컬 서버 프록시.
# 앱 코드는 127.0.0.1 접속만 허용하므로 Host·Origin을 내부 주소로 바꿔 전달합니다.
# 출처(Origin) 확인은 이 프록시가 먼저 수행합니다.

# Origin이 없거나, 현재 접속 주소(Host)와 같으면 허용
map "$http_origin|$http_host" $simasset_same_origin {
    default             0;
    "~^\|"              1;
    "~^https?://([^|/]+)\|\1$" 1;
}
# Origin이 있을 때만 내부 주소로 바꿔 전달 (빈 값이면 헤더를 보내지 않음)
map $http_origin $simasset_review_origin {
    ""      "";
    default "http://127.0.0.1:8765";
}
map $http_upgrade $simasset_connection_upgrade {
    default upgrade;
    ""      close;
}

# ── 결과 검토 화면: 프록시 8005 → 127.0.0.1:8765 ──
server {
    listen 8005;
    server_name _;

    auth_basic           "SimAsset review";
    auth_basic_user_file /etc/nginx/auth/review.htpasswd;

    client_max_body_size 1m;

    location / {
        if ($simasset_same_origin = 0) { return 403; }

        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host            127.0.0.1:8765;
        proxy_set_header Origin          $simasset_review_origin;
        proxy_set_header Authorization   "";
        proxy_set_header Accept-Encoding "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;

        # 화면 안의 Grafana 링크를 외부 주소로
        sub_filter       'http://127.0.0.1:3015' 'http://${PUBLIC_HOST}:${PUBLIC_GRAFANA_PORT}';
        sub_filter_once  off;
        sub_filter_types text/html;
    }
}

# ── Grafana: 프록시 8006 → 127.0.0.1:3015 ──
server {
    listen 8006;
    server_name _;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3015;
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header Accept-Encoding   "";
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 대시보드 JSON 안의 검토 화면·Grafana 링크를 외부 주소로
        sub_filter       'http://127.0.0.1:8765' 'http://${PUBLIC_HOST}:${PUBLIC_REVIEW_PORT}';
        sub_filter       'http://127.0.0.1:3015' 'http://${PUBLIC_HOST}:${PUBLIC_GRAFANA_PORT}';
        sub_filter_once  off;
        sub_filter_types application/json;
    }

    location /api/live/ {
        proxy_pass http://127.0.0.1:3015;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $simasset_connection_upgrade;
        proxy_set_header Host       $http_host;
    }
}
