# .env 견본. 복사해서 값을 채웁니다: cp .env.sample .env
# 값에 '$'를 넣지 마세요. compose가 변수로 해석합니다.

COMPOSE_PROJECT_NAME=simasset-review
TZ=Asia/Seoul

# 브라우저에서 접속할 주소 (외부 IP 또는 도메인)
PUBLIC_HOST=127.0.0.1
BIND_ADDRESS=0.0.0.0

# 이 컴퓨터에서 여는 포트
REVIEW_PORT=8005
GRAFANA_PORT=8006
DB_PORT=8007

# 브라우저가 실제로 쓰는 외부 포트 (공유기에서 포트를 바꿔 넘기는 경우). 같으면 위와 동일하게.
PUBLIC_REVIEW_PORT=8005
PUBLIC_GRAFANA_PORT=8006

# DB 이름은 simasset_review로 시작해야 합니다. 비밀번호는 URL에 그대로 들어가므로
# 영문·숫자·-·_ 만 사용합니다. 예: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_USER=simasset_dev
POSTGRES_PASSWORD=change-me
POSTGRES_DB=simasset_review
POSTGRES_INTERNAL_PORT=55438

REVIEW_AUTH_USER=admin
REVIEW_AUTH_PASSWORD=change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# 절대경로 권장
SIMASSET_RESULTS_DIR=/absolute/path/to/SimAsset-Evaluation/review/evidence
HOST_UID=1000
HOST_GID=1000
