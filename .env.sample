# .env 견본. 복사한 뒤 값을 채웁니다:  cp .env.sample .env
#
# 표시 [그대로]  보통 바꾸지 않습니다
#      [직접]    이 컴퓨터에서 직접 정하거나 만드는 값
#      [받기]    팀 담당자에게 비공개(DM 등)로 받는 값
#
# 주의
# - .env는 Git에 올라가지 않습니다. 이 파일(.env.sample)은 공개 저장소에 올라가므로
#   실제 주소·비밀번호·키를 여기에 적지 마세요.
# - 값에 '$'를 넣지 마세요. compose가 변수로 해석합니다.
# - 비밀번호를 새로 만들 때:  python3 -c "import secrets;print(secrets.token_urlsafe(24))"

# ── 기본 ───────────────────────────────────────────────
# [그대로] Docker 컨테이너 묶음 이름
COMPOSE_PROJECT_NAME=simasset-review
# [그대로] 시간대
TZ=Asia/Seoul

# ── 접속 주소와 포트 ─────────────────────────────────────
# [직접] 다른 사람이 접속할 이 컴퓨터의 주소 (공인 IP 또는 도메인). 이 컴퓨터에서만 쓰면 127.0.0.1
#        서버를 띄우지 않고 공유 DB에 접속만 하는 팀원은 [받기]: 서버 주소
PUBLIC_HOST=127.0.0.1
# [직접] 0.0.0.0 = 다른 컴퓨터에서도 접속 허용, 127.0.0.1 = 이 컴퓨터에서만
BIND_ADDRESS=0.0.0.0

# [직접] 이 컴퓨터에서 여는 포트 (결과 검토 화면 / Grafana / PostgreSQL)
#        공유 DB에 접속만 하는 팀원의 DB_PORT는 [받기]: DB 외부 포트
#        (공유기가 외부 18007 → 내부 8007로 넘기면 팀원에게는 18007)
REVIEW_PORT=8005
GRAFANA_PORT=8006
DB_PORT=8007

# [직접] 브라우저가 실제로 쓰는 외부 포트. 공유기가 다른 번호로 넘겨줄 때만 바꿉니다
#        (예: 외부 18005 → 내부 8005이면 18005). 그렇지 않으면 위 포트와 같게.
PUBLIC_REVIEW_PORT=8005
PUBLIC_GRAFANA_PORT=8006

# ── PostgreSQL (결과 DB) ─────────────────────────────────
# 서버를 띄우는 사람: 이 컴퓨터에 만들 DB의 값입니다. DB를 처음 만들 때만 적용됩니다
#                     (이후 변경은 .devcontainer/README.md 참고).
# 접속만 하는 팀원:   담당자에게 받은 값을 같은 이름에 넣습니다. 주소는 PUBLIC_HOST, 포트는 DB_PORT.
#   psql:    psql "postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$PUBLIC_HOST:$DB_PORT/$POSTGRES_DB?sslmode=disable"
#   DBeaver: Host=PUBLIC_HOST, Port=DB_PORT, Database=POSTGRES_DB,
#            Username=POSTGRES_USER, Password=POSTGRES_PASSWORD, SSL 끔
#   조회용입니다. 결과 가져오기(simasset-review import)는 서버 컴퓨터에서만 됩니다.
#
# [그대로] DB 이름. simasset_review로 시작해야 합니다
POSTGRES_DB=simasset_review
# [그대로 · 팀원은 받기] DB 계정
POSTGRES_USER=simasset_dev
# [직접 · 팀원은 받기] DB 비밀번호. URL에 그대로 들어가므로 영문·숫자·-·_ 만 씁니다
POSTGRES_PASSWORD=change-me
# [그대로] 컨테이너 안 DB 포트 (서버를 띄우는 사람만 사용)
POSTGRES_INTERNAL_PORT=55438

# ── 화면 로그인 ─────────────────────────────────────────
# [직접] 결과 검토 화면(REVIEW_PORT)의 로그인 계정
REVIEW_AUTH_USER=admin
REVIEW_AUTH_PASSWORD=change-me

# [직접] Grafana 관리자 계정. Grafana 데이터를 처음 만들 때만 적용됩니다
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ── 결과 폴더와 파일 소유자 ───────────────────────────────
# [직접] 가져올 결과를 두는 폴더의 절대경로. 보통 저장소의 review/evidence
SIMASSET_RESULTS_DIR=/absolute/path/to/SimAsset-Evaluation/review/evidence
# [직접] 이 컴퓨터 사용자의 번호. 터미널에서 `id -u`, `id -g` 결과를 넣습니다
HOST_UID=1000
HOST_GID=1000

# ── MinIO 공유 저장소 (하네스 ZIP·에셋·실행 결과·영상) ──────────
# 네 값 모두 담당자에게 비공개로 받습니다. 서버 주소도 공개 저장소에 적지 마세요.
#
# [받기] 서버 주소. http:// 또는 https:// 와 포트까지 적습니다
MINIO_ENDPOINT="http://<서버 주소>:<포트>"
# [그대로] 이 프로젝트 전용 버킷. 모두 같은 값을 씁니다
MINIO_BUCKET=simready
# [받기] 버킷 전용 공용 계정 키 (관리자 키 아님).
#        simready 버킷만 읽기·쓰기·삭제할 수 있고, 지운 파일은 버전으로 남아 복구할 수 있습니다
MINIO_ACCESS_KEY="<담당자에게 받은 접속 키>"
MINIO_SECRET_KEY="<담당자에게 받은 비밀 키>"
#
# 팀원은 여기까지만 채우면 됩니다. 아래는 MinIO 관리자가 처음 한 번만 합니다:
#   위 두 키 자리에 MinIO 관리자 키를 잠시 넣고 아래를 실행하면, 버킷·버킷 전용 계정을 만들고
#   권한을 확인한 뒤 이 두 줄을 버킷 전용 키로 바꿔 씁니다. 관리자 키는 .env에 남지 않습니다.
#     .devcontainer/docker/storage/setup-minio.sh
#   (선택) 계정 이름 지정:   MINIO_TEAM_USER=simready-team .devcontainer/docker/storage/setup-minio.sh
#   (선택) 같은 계정 키 재발급: MINIO_ROTATE=1 .devcontainer/docker/storage/setup-minio.sh
