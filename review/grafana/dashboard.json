      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "simasset-local-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "simasset-local-postgres"
          },
          "rawSql": "SELECT * FROM review.v_test_coverage ORDER BY asset,test_type,source_namespace",
          "format": "table",
          "rawQuery": true
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "측정값과 SI 단위",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "simasset-local-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "simasset-local-postgres"
          },
          "rawSql": "SELECT run_id,asset,asset_version,test_type,seed,origin,metric_name,metric_value,metric_text,unit,valid,invalid_reason FROM review.v_run_metrics ORDER BY asset,run_id,metric_name LIMIT 1000",
          "format": "table",
